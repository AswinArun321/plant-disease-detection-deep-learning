# Model directories
models/baseline/*
models/experiments/*

# Keep directory structure
!models/baseline/.gitkeep
!models/experiments/.gitkeep

# Final model directory
# Keep class mapping but ignore large model files
models/final/*.keras
models/final/*.h5
models/final/*.hdf5
models/final/*.weights.h5

!models/final/class_names.json
!models/final/.gitkeep


